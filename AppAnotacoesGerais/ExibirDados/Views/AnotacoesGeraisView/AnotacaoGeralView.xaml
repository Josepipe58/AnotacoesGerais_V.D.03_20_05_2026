<UserControl x:Class="AppAnotacoesGerais.ExibirDados.Views.AnotacoesGeraisView.AnotacaoGeralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAnotacoesGerais.ExibirDados.ViewModels.AnotacoesGerais"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" xml:lang="pt-BR" d:DesignHeight="950" d:DesignWidth="1450">

    <UserControl.DataContext>
        <local:AnotacaoGeralViewModel/>
    </UserControl.DataContext>

    <Border CornerRadius="10" Background="#FF021507">

        <!--| Grid Principal |-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--| Grid Superior |-->
            <Grid Grid.Row="0">

                <!--| Rótulos(Label)|-->
                <Label Content="G E R E N C I A R  A N O T A Ç Õ E S  G E R A I S" Style="{DynamicResource LabelTransparente}" 
                       FontSize="28" Margin="400,10,0,0"/>

                <Label Content="Código" Style="{DynamicResource LabelTransparente}" Margin="30,100,0,0"/>

                <!--| TextBoxes |-->
                <TextBox x:Name="TxtId" Text="{Binding AnotacaoGeralModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource TxtBrancoEBordaVerde}" FontSize="20" Width="70" Margin="105,97,0,0"/>

                <!--| ComboBoxes |-->
                <ComboBox Name="CbxCategoria" Height="40" Width="300" Style="{DynamicResource ComboBoxVerde}" Margin="200,95,0,0"
                          Text="{Binding AnotacaoGeralModel.NomeCategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding CategoriaModel.ListaDeCategorias}" DisplayMemberPath="NomeCategoria" SelectedValuePath="Id"
                          SelectedItem="{Binding CategoriaSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Name="CbxSubcategoria" Height="40" Width="350" Style="{DynamicResource ComboBoxVerde}" Margin="550,95,0,0" 
                          Text="{Binding AnotacaoGeralModel.NomeSubcategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding SubcategoriaModel.ListaDeSubcategorias}" DisplayMemberPath="NomeSubcategoria" SelectedValuePath="Id"                                              
                          SelectedItem="{Binding SubcategoriaSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedIndex="{Binding SubcategoriaModel.IndiceSelecionadoSubcategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Height="40" Width="400" Style="{DynamicResource ComboBoxVerde}" Margin="950,95,0,0" SelectedValuePath="Id"
                          Text="{Binding AnotacaoGeralModel.NomeDaDescricao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding NomeDescricaoModel.ListaDoNomeDescricao}" DisplayMemberPath="NomeDaDescricao"                      
                          SelectedItem="{Binding NomeDescricaoSelecionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!--| Botões |-->
                <Button Content="ADICIONAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="65,170,0,0"
                        Command="{Binding ComandoAbrirJanelaAdicionarAnotacaoGeral}"/>

                <Button Content="EDITAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="255,170,0,0"
                        Command="{Binding ComandoAbrirJanelaEditarAnotacaoGeral}"/>

                <Button Content="EXCLUIR" Style="{DynamicResource BtnVerdeRedondo}" Margin="445,170,0,0"
                        Command="{Binding ComandoExcluirAnotacaoGeral}"/>

                <Button Content="ATUALIZAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="635,170,0,0"
                        Command="{Binding ComandoAtualizarAnotacaoGeral}"/>
            </Grid>

            <Grid Grid.Row="1">
                <!--| Data Grid de Dados |-->
                <DataGrid x:Name="DtgDados" Style="{DynamicResource DtgDadosEditorTextoInterno}" ItemsSource="{Binding ListaDeAnotacoesGerais}"
                          Height="700" ColumnHeaderStyle="{DynamicResource CabecalhoTransparente}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Id, StringFormat=\{0:D4\}}" Width="100"/>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding NomeCategoria}" Width="300"/>
                        <DataGridTextColumn Header="Subcategoria" Binding="{Binding NomeSubcategoria}" Width="400"/>
                        <DataGridTextColumn Header="Nome Da Descrição" Binding="{Binding NomeDaDescricao}" Width="490"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="125"/>
                    </DataGrid.Columns>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding ComandoDuploClickAnotacaoGeral}" 
                                                   CommandParameter="{Binding SelectedItem, ElementName=DtgDados}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
