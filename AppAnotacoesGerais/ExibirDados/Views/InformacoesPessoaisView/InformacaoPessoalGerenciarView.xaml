<UserControl x:Class="AppAnotacoesGerais.ExibirDados.Views.InformacoesPessoaisView.InformacaoPessoalGerenciarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAnotacoesGerais.ExibirDados.ViewModels.InformacoesPessoais"
             mc:Ignorable="d" xml:lang="pt-BR" d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.DataContext>
        <local:InformacaoPessoalViewModel/>
    </UserControl.DataContext>

    <Grid Background="#FF22C5B2">
        <Border CornerRadius="25,25,25,25" Background="#FF021507" BorderThickness="2,4,3,9" Margin="5,5,5,0">
            <Grid >
                <!--| Título |-->
                <Label Content="G E R E N C I A R   I N F O R M A Ç Ã O   P E S S O A L" Style="{DynamicResource LabelTransparente}" Foreground="White" 
                       FontSize="28" Margin="400,20,0,0"/>

                <!--|Borda do Título |-->
                <Border  CornerRadius="25,25,25,25" Background="#FF22C5B2" BorderThickness="2,4,3,9" Width="1090" Height="120"
                         Margin="25,165,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <TextBox x:Name="TxtTitulo" Text="{Binding InformacaoPessoalModel.Titulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="20" FontWeight="Bold" Foreground="#FF021507" TextWrapping="Wrap" AcceptsTab="True" AcceptsReturn="True" 
                             Margin="10,10,10,10"/>
                </Border>

                <!--|Borda da Descrição |-->
                <Border Background="#FF22C5B2" CornerRadius="25,25,25,25" BorderThickness="2,4,3,9" Margin="25,337,0,0" Width="1090"
                        HorizontalAlignment="Left">

                    <TextBox x:Name="TxtDescricao" Text="{Binding InformacaoPessoalModel.Descricao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="20" FontWeight="Bold" Foreground="#FF021507" Margin="10,10,10,10" TextWrapping="Wrap" AcceptsTab="True" 
                             AcceptsReturn="True"/>
                </Border>

                <!--| Rótulos[Label] -->
                <Label Content="Código" Style="{DynamicResource LabelTransparente}" Margin="30,65,0,0"/>

                <Label Content="Título" Style="{DynamicResource LabelTransparente}" Height="40" Margin="30,135,0,0" Padding="10,10,0,0" Width="100"/>

                <Label Content="Descrição" Style="{DynamicResource LabelTransparente}" FontSize="20" Height="40" Margin="30,300,0,0" Padding="10,10,0,0" 
                       Width="120"/>

                <!--| TextBoxes |-->
                <TextBox x:Name="TxtId" Text="{Binding InformacaoPessoalModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" 
                         FontSize="20" FontWeight="Bold" Style="{DynamicResource TxtBrancoEBordaVerde}" Margin="35,90,0,0" IsReadOnly="True"/>

                <!--| Botões |-->
                <Button Content="ADICIONAR" Style="{DynamicResource BtnVerdeRedondo}" 
                        Margin="1140,175,0,0" Command="{Binding ComandoAdicionarInformacaoPessoal}"/>

                <Button Content="EDITAR" Style="{DynamicResource BtnVerdeRedondo}" 
                        Margin="1140,255,0,0" Command="{Binding ComandoEditarInformacaoPessoal}"/>

                <Button Content="ATUALIZAR" Style="{DynamicResource BtnVerdeRedondo}" 
                        Margin="1140,335,0,0" Command="{Binding ComandoAtualizarInformacaoPessoalGerenciarView}"/>

                <Button Content="VOLTAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="1140,415,0,0" 
                        Command="{Binding ComandoVoltarInformacaoPessoal}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
