<UserControl x:Class="AppAnotacoesGerais.ExibirDados.Views.InformacoesPessoaisView.InformacaoPessoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAnotacoesGerais.ExibirDados.ViewModels.InformacoesPessoais"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" xml:lang="pt-BR" d:DesignHeight="950" d:DesignWidth="1450">

    <UserControl.DataContext>
        <local:InformacaoPessoalViewModel/>
    </UserControl.DataContext>
    
    <Border CornerRadius="10" Background="#FF021507">
        
            <!--| Grid Principal |-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>                    
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--| Grid Superior |-->
                <Grid Grid.Row="0">

                    <!--| Rótulos(Label)|-->
                    <Label Content="G E R E N C I A R  I N F O R M A Ç Õ E S  P E S S O A I S" Style="{DynamicResource LabelTransparente}" 
                           FontSize="28" Margin="400,10,0,0"/>

                    <Label Content="Código" Style="{DynamicResource LabelTransparente}" Margin="33,90,0,0"/>

                    <!--| TextBoxes |-->
                    <TextBox x:Name="TxtId" Text="{Binding InformacaoPessoalModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TxtBrancoEBordaVerde}" FontSize="20" Width="70" Margin="110,85,0,0"/>

                    <!--| Botões |-->
                    <Button Content="ADICIONAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="230,85,0,0"
                            Command="{Binding ComandoAbrirJanelaAdicionarInformacaoPessoal}"/>

                    <Button Content="EDITAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="420,85,0,0"
                            Command="{Binding ComandoAbrirJanelaEditarInformacaoPessoal}"/>

                    <Button Content="EXCLUIR" Style="{DynamicResource BtnVerdeRedondo}" Margin="610,85,0,0"
                            Command="{Binding ComandoExcluirInformacaoPessoal}"/>

                    <Button Content="ATUALIZAR" Style="{DynamicResource BtnVerdeRedondo}" Margin="800,85,0,0"
                            Command="{Binding ComandoAtualizarInformacaoPessoal}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <!--| Data Grid de Dados |-->
                    <DataGrid x:Name="DtgDados" Style="{DynamicResource DtgDadosEditorTextoInterno}"
                              ItemsSource="{Binding ListaDeInformacoesPessoais}"
                              ColumnHeaderStyle="{DynamicResource CabecalhoTransparente}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Id, StringFormat=\{0:D4\}}" Width="120"/>
                            <DataGridTextColumn Header="TÍTULO" Binding="{Binding Titulo}" Width="1295"/>
                        </DataGrid.Columns>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseDoubleClick">
                                <b:InvokeCommandAction Command="{Binding ComandoDuploClickInformacaoPessoal}" 
                                   CommandParameter="{Binding SelectedItem, ElementName=DtgDados}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </DataGrid>
                </Grid>
            </Grid>
    </Border>
</UserControl>
