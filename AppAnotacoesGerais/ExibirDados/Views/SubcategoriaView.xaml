<UserControl x:Class="AppAnotacoesGerais.ExibirDados.Views.SubcategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppAnotacoesGerais.ExibirDados.ViewModels.Subcategorias"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" xml:lang="pt-BR" d:DesignHeight="950" d:DesignWidth="1400">

    <UserControl.DataContext>
        <local:SubcategoriaViewModel/>
    </UserControl.DataContext>

    <Border CornerRadius="10" Background="#FF052503">
        <!--| Grid Principal |-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--| Grid Superior |-->
            <Grid>
                <!--| Rótulos |-->
                <Label Content="G E R E N C I A R  S U B C A T E G O R I A S" Style="{DynamicResource LabelTransparente}" 
                       FontSize="28" Margin="400,10,0,0" Cursor=""/>

                <Label Content="Código da Categoria" Style="{DynamicResource LabelTransparente}" Margin="60,90,0,0"/>

                <Label Content="Código da Subcategoria" Style="{DynamicResource LabelTransparente}" Margin="30,150,0,0"/>

                <Label Content="Nome da Categoria" Style="{DynamicResource LabelTransparente}" Margin="365,90,0,0"/>

                <Label Content="Nome da Subcategoria" Style="{DynamicResource LabelTransparente}" Margin="346,150,0,0"/>

                <ComboBox Style="{DynamicResource ComboBoxVerde}" Width="300" Margin="535,85,0,0" SelectedIndex="0" 
                          Text="{Binding SubcategoriaModel.NomeCategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="NomeCategoria" SelectedValuePath="Id" ItemsSource="{Binding CategoriaModel.ListaDeCategorias}"                            
                          SelectedValue="{Binding SubcategoriaModel.CategoriaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!--| TextBoxes |-->
                <TextBox Width="80" Style="{DynamicResource TxtBrancoEBordaVerde}" Margin="240,85,0,0"
                         Text="{Binding SubcategoriaModel.CategoriaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Width="80" Style="{DynamicResource TxtBrancoEBordaVerde}" Margin="235,145,0,0"
                         Text="{Binding SubcategoriaModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Width="300" Style="{DynamicResource TxtBrancoEBordaVerde}" Margin="545,145,0,0"
                         Text="{Binding SubcategoriaModel.NomeSubcategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!--| Pesquisar Subcategorias|-->
                <Grid Margin="900,170,0,0" Height="80" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <TextBox x:Name="TxtPesquisar" Style="{StaticResource PesquisarTextBox}" Margin="0,20,0,10"
                             Text="{Binding TextoPesquisa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40"/>

                    <TextBlock x:Name="TxbPesquisar" Text="Pesquisar Subcategorias" Style="{StaticResource PesquisarTextBlock}" 
                               Margin="0,20,0,0" VerticalAlignment="Center" Height="40"/>

                    <Button Content="Limpar" FontSize="18" Height="40" Width="160" Style="{DynamicResource BtnVerdeRedondo}" Margin="220,10,0,0"
                            Command="{Binding ComandoAtualizarSubcategoria}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <!--| Botões |-->
                <Button Content="Adicionar" Command="{Binding ComandoAdicionarSubcategoria}" Style="{StaticResource BtnVerdeRedondo}" 
                        Margin="47,200,0,0"/>

                <Button Content="Editar" Command="{Binding ComandoEditarSubcategoria}" Style="{StaticResource BtnVerdeRedondo}" 
                        Margin="217,200,0,0"/>

                <Button Content="Excluir" Command="{Binding ComandoExcluirSubcategoria}" Style="{StaticResource BtnVerdeRedondo}" 
                        Margin="387,200,0,0"/>

                <Button Content="Atualizar" Command="{Binding ComandoAtualizarSubcategoria}" Style="{StaticResource BtnVerdeRedondo}" 
                        Margin="557,200,0,0"/>
            </Grid>
            <!--| DataGrid Dados |-->
            <Grid Grid.Row="1">
                <DataGrid x:Name="DtgDados" Style="{DynamicResource DtgDadosTransparente}" IsReadOnly="True"
                          ItemsSource="{Binding SubcategoriaModel.ListaDeSubcategorias}" 
                          ColumnHeaderStyle="{DynamicResource CabecalhoTransparente}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CategoriaId, StringFormat=\{0:D4\}}" Width="110"/>
                        <DataGridTextColumn Header="Nome da Categoria" Binding="{Binding NomeCategoria}" Width="500"/>
                        <DataGridTextColumn Header="Código" Binding="{Binding Id, StringFormat=\{0:D4\}}" Width="110"/>
                        <DataGridTextColumn Header="Nome da Subcategoria" Binding="{Binding NomeSubcategoria}" Width="670"/>
                    </DataGrid.Columns>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding ComandoDuploClickSubcategoria}" 
                                                   CommandParameter="{Binding SelectedItem, ElementName=DtgDados}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
