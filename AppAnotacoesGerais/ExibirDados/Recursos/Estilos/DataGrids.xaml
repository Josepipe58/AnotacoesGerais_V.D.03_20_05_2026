<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--=====================================| DtgDadosEditorTextoInterno |===============================================-->
    <Style TargetType="{x:Type DataGrid}" x:Key="DtgDadosEditorTextoInterno">
        <Setter Property="FontSize" Value= "14"/>
        <Setter Property="Foreground" Value="{DynamicResource CorDaFonte_01}"/>
        <Setter Property="FontWeight" Value= "Bold"/>
        <Setter Property="Background" Value= "{DynamicResource CorDeFundo_04}"/>
        <Setter Property="Cursor" Value= "Hand"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="RowBackground" Value= "{DynamicResource CorTransparente}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CorBranca}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CorBranca}"/>
        <Setter Property="SelectedIndex" Value="-1"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorDaBorda_01}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowDetailsTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel Background="{DynamicResource CorDeFundo_05}" IsEnabled="True" Margin="0,10,0,10">

                        <Border  x:Name="Borda04" BorderBrush="{DynamicResource CorDaBorda_04}" Background="{x:Null}" Margin="0,10,0,10" CornerRadius="25,25,25,25" 
                                 BorderThickness="2,4,3,9" Width="1350" Height="580">

                            <RichTextBox x:Name="RtbEditor" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CorDaFonte_01}" Margin="10 10 10 0"
                                         Background="{DynamicResource CorDeFundo_03}" AcceptsTab="True" IsReadOnly="False" AcceptsReturn="True" Height="Auto"
                                         Width="1325" MinHeight="100" MaxHeight="550" Padding="15 15 0 0" HorizontalScrollBarVisibility="Auto" 
                                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">

                                <FlowDocument PageWidth="{Binding ActualWidth, ElementName=RtbDescricao}">
                                    <Paragraph>
                                        <Run Text="{Binding Descricao}"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </Border>
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--======================================| DtgDadosTransparente |====================================================-->
    <Style TargetType="{x:Type DataGrid}" x:Key="DtgDadosTransparente">
        <Setter Property="FontFamily" Value= "Calibri"/>
        <Setter Property="FontSize" Value= "15"/>
        <Setter Property="Foreground" Value="{DynamicResource CorDaFonte_01}"/>
        <Setter Property="FontWeight" Value= "Bold"/>
        <Setter Property="Background" Value= "{DynamicResource CorDeFundo_04}"/>
        <Setter Property="Cursor" Value= "Hand"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowBackground" Value="{DynamicResource CorTransparente}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource CorTransparente}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CorBranca}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CorBranca}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value= "{DynamicResource CorDaBorda_01}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    
    <!--=============================================| CabecalhoTransparente |============================================-->
    <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="CabecalhoTransparente">
        <Setter Property="Background" Value="{DynamicResource CorDeFundo_04}"/>
        <Setter Property="Foreground" Value="{DynamicResource CorDaFonte_01}"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CorDaBorda_01}"/>
    </Style>
</ResourceDictionary>